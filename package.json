{
  "name": "@terrestris/mapa11y",
  "version": "1.0.0",
  "description": "This plugin provides some filters for people with color vision deficiency in the context of accessibility",
  "keywords": [
    "accessibility",
    "color-blindness",
    "color-vision",
    "a11y",
    "contrast",
    "filter",
    "visual-impairment",
    "inclusive-design",
    "web-accessibility",
    "color-deficiency",
    "vision-helper",
    "ui-enhancement",
    "assistive-technology",
    "color-adjustment"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/terrestris/mapa11y.git"
  },
  "author": {
    "name": "terrestris GmbH & Co. KG",
    "email": "info@terrestris.de",
    "url": "https://www.terrestris.de"
  },
  "contributors": [
    {
      "name": "Michael Holthausen",
      "email": "holthausen@terrestris.de"
    }
  ],
  "license": "BSD-2-Clause",
  "main": "dist/mapa11y.umd.js",
  "module": "dist/mapa11y.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build:types": "tsc --project tsconfig.build.json",
    "build:lib": "BUILD_TYPE=lib vite build && npm run build:types",
    "build:web": "vite build",
    "build": "npm run build:lib && npm run build:web",
    "lint": "eslint 'src/**/*.{ts,tsx,js,jsx}'",
    "preview": "vite preview",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare": "husky",
    "test": "vitest --coverage --no-watch",
    "release": "npm run clean; npm run build; npx semantic-release"
  },
  "peerDependencies": {
    "i18next": ">=24",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^15.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.35.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.6",
    "@semantic-release/npm": "12.0.2",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@stylistic/eslint-plugin": "5.3.1",
    "@terrestris/eslint-config-typescript": "10.0.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.5.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "8.44.0",
    "@vitejs/plugin-react": "5.0.3",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "jsdom": "27.0.0",
    "ol": "10.6.1",
    "prettier": "3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semantic-release": "24.2.8",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vite": "7.1.6",
    "vitest": "3.2.4"
  }
}
